          && validText(request.resource.data.fields.countTemplate, 300)
          && validText(request.resource.data.fields.titleFormatHint, 300)
          && validText(request.resource.data.fields.designEyebrow, 40)
          && validText(request.resource.data.fields.designRole, 40)
          && validText(request.resource.data.fields.designIntro, 200)
          && validText(request.resource.data.fields.designAction, 40)
          && validText(request.resource.data.fields.instrumentEyebrow, 40)
          && validText(request.resource.data.fields.instrumentRole, 40)
          && validText(request.resource.data.fields.instrumentIntro, 200)
          && validText(request.resource.data.fields.instrumentAction, 40)
          && validText(request.resource.data.fields.designGuide, 400)
          && validText(request.resource.data.fields.designPrivacy, 200)
          && validText(request.resource.data.fields.designImportLabel, 40)
          && validText(request.resource.data.fields.designImportPrompt, 40)
          && validText(request.resource.data.fields.designImportEmpty, 200)
          && validText(request.resource.data.fields.designQuestionLabel, 40)
          && validText(request.resource.data.fields.designQuestionPlaceholder, 200)
          && validText(request.resource.data.fields.designTitleLabel, 40)
          && validText(request.resource.data.fields.designTitlePlaceholder, 200)
          && validText(request.resource.data.fields.designTitlePick, 40)
          && validText(request.resource.data.fields.designConditionsLegend, 40)
          && validText(request.resource.data.fields.designConditionsHint, 200)
          && validText(request.resource.data.fields.stageLabel, 40)
          && validText(request.resource.data.fields.designClassesLabel, 40)
          && validText(request.resource.data.fields.designParallelLabel, 40)
          && validText(request.resource.data.fields.designPeriodLabel, 40)
          && validText(request.resource.data.fields.designDataLabel, 40)
          && validText(request.resource.data.fields.designAbilityLabel, 40)
          && validText(request.resource.data.fields.designSupportLabel, 40)
          && validText(request.resource.data.fields.designPurposeLabel, 40)
          && validText(request.resource.data.fields.designPreferenceLabel, 40)
          && validText(request.resource.data.fields.designNotesLabel, 40)
          && validText(request.resource.data.fields.designNotesPlaceholder, 200)
          && validText(request.resource.data.fields.designGenerateAction, 40)
          && validText(request.resource.data.fields.designProgress, 100)
          && validText(request.resource.data.fields.designEmpty, 200)
          && validText(request.resource.data.fields.designRequiredError, 200)
          && validText(request.resource.data.fields.designFormatError, 200)
          && validText(request.resource.data.fields.designResponseLabel, 40)
          && validText(request.resource.data.fields.designAnalysisHeading, 40)
          && validText(request.resource.data.fields.designScopeHeading, 40)
          && validText(request.resource.data.fields.designTitleHeading, 40)
          && validText(request.resource.data.fields.designRecommendedHeading, 40)
          && validText(request.resource.data.fields.designMinimalLabel, 40)
          && validText(request.resource.data.fields.designExcludedHeading, 40)
          && validText(request.resource.data.fields.designPlanHeading, 40)
          && validText(request.resource.data.fields.designToolsHeading, 40)
          && validText(request.resource.data.fields.designEthicsHeading, 40)
          && validText(request.resource.data.fields.designPendingHeading, 40)
          && validText(request.resource.data.fields.designExistingMaterial, 100)
          && validText(request.resource.data.fields.designToCoachAction, 40)
          && validText(request.resource.data.fields.designToWorkshopAction, 40)
          && validText(request.resource.data.fields.designTsvAction, 40)
          && validText(request.resource.data.fields.designSaveAction, 40)
          && validText(request.resource.data.fields.designSavedHint, 100)
          && validText(request.resource.data.fields.designNewAction, 40)
          && validText(request.resource.data.fields.designReadOnlyHint, 200)
          && validText(request.resource.data.fields.coachHandoffAction, 40)
          && validText(request.resource.data.fields.coachHandoffMissing, 200)
          && validText(request.resource.data.fields.coachBusyHint, 200)
          && validText(request.resource.data.fields.handoffConfirm, 200)
          && validText(request.resource.data.fields.instrumentGuide, 400)
          && validText(request.resource.data.fields.instrumentPrivacy, 200)
          && validText(request.resource.data.fields.modeTabLabel, 40)
          && validText(request.resource.data.fields.modeQuestionnaire, 40)
          && validText(request.resource.data.fields.modeInterview, 40)
          && validText(request.resource.data.fields.modeObservation, 40)
          && validText(request.resource.data.fields.instrumentSourceLabel, 40)
          && validText(request.resource.data.fields.sourceNewLabel, 40)
          && validText(request.resource.data.fields.sourceDraftLabel, 40)
          && validText(request.resource.data.fields.instrumentImportLabel, 40)
          && validText(request.resource.data.fields.instrumentImportPrompt, 40)
          && validText(request.resource.data.fields.instrumentImportRow, 40)
          && validText(request.resource.data.fields.instrumentImportEmpty, 200)
          && validText(request.resource.data.fields.instrumentQuestionLabel, 40)
          && validText(request.resource.data.fields.subQuestionLabel, 40)
          && validText(request.resource.data.fields.subQuestionPlaceholder, 200)
          && validText(request.resource.data.fields.respondentLabel, 40)
          && validText(request.resource.data.fields.targetLabel, 40)
          && validText(request.resource.data.fields.targetPlaceholder, 200)
          && validText(request.resource.data.fields.dimensionsLabel, 40)
          && validText(request.resource.data.fields.dimensionsPlaceholder, 200)
          && validText(request.resource.data.fields.observationDimensionsLabel, 40)
          && validText(request.resource.data.fields.itemsPerDimensionLabel, 40)
          && validText(request.resource.data.fields.scaleLabel, 40)
          && validText(request.resource.data.fields.demographicsLabel, 40)
          && validText(request.resource.data.fields.scaleNameLabel, 40)
          && validText(request.resource.data.fields.scaleNamePlaceholder, 200)
          && validText(request.resource.data.fields.formatLabel, 40)
          && validText(request.resource.data.fields.durationLabel, 40)
          && validText(request.resource.data.fields.topicsLabel, 40)
          && validText(request.resource.data.fields.topicsPlaceholder, 200)
          && validText(request.resource.data.fields.sceneLabel, 40)
          && validText(request.resource.data.fields.samplingLabel, 40)
          && validText(request.resource.data.fields.samplingHint, 200)
          && validText(request.resource.data.fields.observerLabel, 40)
          && validText(request.resource.data.fields.draftLabel, 40)
          && validText(request.resource.data.fields.draftPlaceholder, 200)
          && validText(request.resource.data.fields.instrumentGenerateAction, 40)
          && validText(request.resource.data.fields.instrumentReviewDraftAction, 40)
          && validText(request.resource.data.fields.instrumentProgress, 100)
          && validText(request.resource.data.fields.instrumentEmpty, 200)
          && validText(request.resource.data.fields.instrumentRequiredError, 200)
          && validText(request.resource.data.fields.instrumentFormatError, 200)
          && validText(request.resource.data.fields.lowGradeHint, 200)
          && validText(request.resource.data.fields.dimensionsLimitError, 100)
          && validText(request.resource.data.fields.instrumentResponseLabel, 40)
          && validText(request.resource.data.fields.checksHeading, 40)
          && validText(request.resource.data.fields.checksEmpty, 100)
          && validText(request.resource.data.fields.reviewHeading, 40)
          && validText(request.resource.data.fields.reviewAction, 40)
          && validText(request.resource.data.fields.reviewProgress, 100)
          && validText(request.resource.data.fields.reviewSummaryLabel, 40)
          && validText(request.resource.data.fields.reviewEmpty, 100)
          && validText(request.resource.data.fields.reviewStale, 40)
          && validText(request.resource.data.fields.adoptAction, 40)
          && validText(request.resource.data.fields.adoptDeleteAction, 40)
          && validText(request.resource.data.fields.adoptedLabel, 40)
          && validText(request.resource.data.fields.removedLabel, 40)
          && validText(request.resource.data.fields.locateAction, 40)
          && validText(request.resource.data.fields.deleteItemAction, 40)
          && validText(request.resource.data.fields.addItemAction, 40)
          && validText(request.resource.data.fields.addProbeAction, 40)
          && validText(request.resource.data.fields.addBlockAction, 40)
          && validText(request.resource.data.fields.deleteBlockConfirm, 100)
          && validText(request.resource.data.fields.limitReachedHint, 100)
          && validText(request.resource.data.fields.useDimensionsAction, 40)
          && validText(request.resource.data.fields.adaptationLabel, 40)
          && validText(request.resource.data.fields.administrationHeading, 40)
          && validText(request.resource.data.fields.reliabilityHeading, 40)
          && validText(request.resource.data.fields.reliabilityGuide, 400)
          && validText(request.resource.data.fields.printAction, 40)
          && validText(request.resource.data.fields.instrumentTsvAction, 40)
          && validText(request.resource.data.fields.instrumentSaveAction, 40)
          && validText(request.resource.data.fields.instrumentSavedHint, 100)
          && validText(request.resource.data.fields.regenerateConfirm, 100)
          && validText(request.resource.data.fields.printThanks, 40)
          ;
      }

      function validExtendedPageCopy() {
        return pageId in [
            'agents', 'classroom', 'tools', 'resources', 'news', 'paths',
            'articles', 'article', 'prompts', 'workspace'
          ]
          && request.resource.data.fields.keys().size() > 0
          && request.resource.data.fields.keys().size() <= 40;
      }

      allow read: if pageId in [
          'home', 'multimodal', 'agents', 'classroom', 'tools', 'resources',
          'news', 'paths', 'articles', 'article', 'prompts', 'workspace', 'research'
        ];
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['fields', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['fields', 'updatedAt'])
        && request.resource.data.fields is map
        && request.resource.data.updatedAt is string
        && (
          (pageId == 'home' && validHomeCopy())
          || (pageId == 'multimodal' && validMultimodalCopy())
          || (pageId == 'research' && validResearchCopy())
          || validExtendedPageCopy()
        );
      allow delete: if isAdmin();
    }

    match /community_prompts/{promptId} {
      function isAuthor() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function validCreate() {
        return signedIn()
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'category', 'createdAt', 'label', 'likedBy', 'likes', 'note', 'status', 'text'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'category', 'createdAt', 'label', 'likedBy', 'likes', 'note', 'status', 'text'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.category in ['teaching', 'advanced', 'communication', 'other']
          && request.resource.data.status == 'pending'
          && request.resource.data.likes == 0
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size() == 0
          && request.resource.data.createdAt is string;
      }

      function validLikeToggle() {
        return signedIn()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes'])
          && request.resource.data.likedBy is list
          && request.resource.data.likes is int
          && request.resource.data.likes >= 0
          && request.resource.data.likes == request.resource.data.likedBy.size()
          && request.resource.data.likedBy.toSet().size() == request.resource.data.likedBy.size()
          && (
            (!(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1)
              && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
              && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).size() == 0
            ||
            (request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)
              && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).size() == 0
          );
      }

      allow read: if resource.data.status == 'approved' || isAuthor() || isAdmin();
      allow create: if validCreate();
      allow update: if isAdmin() || validLikeToggle();
      allow delete: if isAdmin() || isAuthor();
    }

    match /subscribers/{subscriberId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['email', 'subscribedAt'])
        && request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.subscribedAt is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /contact_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['contact', 'createdAt', 'handled', 'message', 'name', 'page', 'userEmail', 'userId', 'userPhone'])
        && request.resource.data.keys().hasOnly(['contact', 'createdAt', 'handled', 'message', 'name', 'page', 'userEmail', 'userId', 'userPhone'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 500
        && request.resource.data.handled == false
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /works/{workId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 200000;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 200000;
    }

    match /agent_usage/{agentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['count', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /tool_ratings/{docId} {
      allow read, write: if false;
    }

    match /analytics_events/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
