# Copy to /home/ubuntu/.config/t-training.env and set mode 600.
# Keep each value on one line. FIREBASE_SERVICE_ACCOUNT may be base64-encoded JSON.
DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
FIREBASE_SERVICE_ACCOUNT=
# Firebase 迁移切换时再取消下面四行的注释：
# T_TRAINING_AUTH_BACKEND=local
# T_TRAINING_DATA_BACKEND=local
# T_TRAINING_REGISTRATION_BACKEND=local
# T_TRAINING_EMAIL_BACKEND=local
T_TRAINING_DB_HOST=127.0.0.1
T_TRAINING_DB_PORT=3306
T_TRAINING_DB_NAME=t_training_migration
T_TRAINING_DB_USER=t_training_migration
T_TRAINING_DB_PASSWORD=
T_TRAINING_AUTH_SECRET=
# 腾讯云个人认证账号使用 SES API + 审核模板，不使用 SMTP：
T_TRAINING_EMAIL_TRANSPORT=tencent-ses
T_TRAINING_MAIL_FROM=no-reply@notify.teachailab.com
T_TRAINING_MAIL_FROM_NAME=AI 教师培训中心
T_TRAINING_TENCENT_SECRET_ID=
T_TRAINING_TENCENT_SECRET_KEY=
T_TRAINING_TENCENT_SES_REGION=ap-guangzhou
T_TRAINING_TENCENT_SES_VERIFY_TEMPLATE_ID=
T_TRAINING_TENCENT_SES_RESET_TEMPLATE_ID=
# Optional routing overrides:
# AGENT_DEFAULT_PROVIDER=deepseek
# ZHIPU_AGENT_IDS=lesson-design,concept-explainer,quiz-gen,exam-paper,error-diagnosis
