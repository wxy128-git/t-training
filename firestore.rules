rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return authenticated()
        && (isAdmin() || (request.auth.token.email_verified == true
        && request.auth.token.email is string
        && !request.auth.token.email.lower().matches('.*@xylaoshi[.]tel')));
    }

    function isAdmin() {
      return authenticated()
        && request.auth.uid == 'MCUSTieySYczODKB9hkERtyvtZG2';
    }

    function isSelf(uid) {
      return authenticated() && request.auth.uid == uid;
    }

    function validUserProfile(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'school', 'isAdmin', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'school', 'isAdmin', 'joinedAt', 'privacy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 120
        && request.resource.data.isAdmin is bool
        && request.resource.data.joinedAt is string;
    }

    function validPrivacyChange() {
      let p = request.resource.data.get('privacy', null);
      let old = resource.data.get('privacy', null);
      return p == old || validPrivacy(p, old);
    }
    function validPrivacy(p, old) {
      return p is map
        && p.keys().hasAll(['version','acceptedAt','research','researchVersion','researchUpdatedAt'])
        && p.keys().hasOnly(['version','acceptedAt','research','researchVersion','researchUpdatedAt'])
        && p.research == false && p.researchVersion == '2026-09-30.1'
        && p.researchUpdatedAt == request.time
        && ((p.version == '2026-09-30.1' && p.acceptedAt == request.time)
          || (old != null && p.version == old.version && p.acceptedAt == old.acceptedAt)
          || (old == null && p.version == '' && p.acceptedAt == null && p.research == false))
        && (!p.research || (p.version == '2026-09-30.1' && p.acceptedAt is timestamp));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validUserProfile(uid)
        && validPrivacy(request.resource.data.get('privacy', null), null)
        && request.resource.data.privacy.version == '2026-09-30.1'
        && request.resource.data.isAdmin == isAdmin();
      allow update: if isAdmin() || (
        validUserProfile(uid)
        && validPrivacyChange()
        && request.resource.data.isAdmin == resource.data.isAdmin
        && (request.resource.data.email == resource.data.email || (
          signedIn() && request.resource.data.email == request.auth.token.email
        ))
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.joinedAt == resource.data.joinedAt
      );
      allow delete: if isAdmin();
    }

    match /tools/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prompts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paths/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /resource_categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /page_copy/{pageId} {
      function validText(value, maxSize) {
        return value is string && value.size() > 0 && value.size() <= maxSize;
      }

      function validHomeCopy() {
        return request.resource.data.fields.keys().hasAll([
            'heroEyebrow', 'heroTitle', 'heroAccent', 'heroIntro', 'primaryAction',
            'workbookActionGuest', 'workbookActionMember', 'taskHeading',
            'checklistHeading', 'checklistAction', 'resourcesHeading'
          ])
          && request.resource.data.fields.keys().hasOnly([
            'heroEyebrow', 'heroTitle', 'heroAccent', 'heroIntro', 'primaryAction',
            'workbookActionGuest', 'workbookActionMember', 'taskHeading',
            'checklistHeading', 'checklistAction', 'resourcesHeading'
          ])
          && validText(request.resource.data.fields.heroEyebrow, 40)
          && validText(request.resource.data.fields.heroTitle, 50)
          && validText(request.resource.data.fields.heroAccent, 12)
          && validText(request.resource.data.fields.heroIntro, 140)
          && validText(request.resource.data.fields.primaryAction, 24)
          && validText(request.resource.data.fields.workbookActionGuest, 24)
          && validText(request.resource.data.fields.workbookActionMember, 24)
          && validText(request.resource.data.fields.taskHeading, 40)
          && validText(request.resource.data.fields.checklistHeading, 30)
          && validText(request.resource.data.fields.checklistAction, 20)
          && validText(request.resource.data.fields.resourcesHeading, 40);
      }

      function validMultimodalCopy() {
        return request.resource.data.fields.keys().hasAll([
            'heroKicker', 'heroTitle', 'heroAccent', 'heroIntro', 'heroNote',
            'primaryAction', 'secondaryAction', 'featureKicker', 'featureTitle', 'featureAction'
          ])
          && request.resource.data.fields.keys().hasOnly([
            'heroKicker', 'heroTitle', 'heroAccent', 'heroIntro', 'heroNote',
            'primaryAction', 'secondaryAction', 'featureKicker', 'featureTitle', 'featureAction'
          ])
          && validText(request.resource.data.fields.heroKicker, 40)
          && validText(request.resource.data.fields.heroTitle, 50)
          && validText(request.resource.data.fields.heroAccent, 12)
          && validText(request.resource.data.fields.heroIntro, 120)
          && validText(request.resource.data.fields.heroNote, 80)
          && validText(request.resource.data.fields.primaryAction, 24)
          && validText(request.resource.data.fields.secondaryAction, 24)
          && validText(request.resource.data.fields.featureKicker, 40)
          && validText(request.resource.data.fields.featureTitle, 50)
          && validText(request.resource.data.fields.featureAction, 40);
      }

      function validResearchCopy() {
        return request.resource.data.fields.keys().hasAll(['heroKicker', 'heroTitle', 'heroIntro', 'literatureTitle', 'literatureIntro', 'judgmentTitle', 'judgmentIntro', 'privacyTitle', 'privacyIntro', 'funnelEyebrow', 'funnelRole', 'funnelIntro', 'funnelAction', 'funnelGreeting', 'readingEyebrow', 'readingRole', 'readingIntro', 'readingAction', 'libraryGuest', 'libraryMember', 'libraryIntro', 'moreTools', 'funnelPrivacy', 'funnelUnsaved', 'composeLabel', 'composePlaceholder', 'sourceHint', 'questionLabel', 'questionPlaceholder', 'metaLabel', 'metaPlaceholder', 'repeatHint', 'readingPrivacy', 'readingEmpty', 'libraryTitle', 'libraryExportHint', 'libraryEmpty', 'generateAction', 'noteLabel', 'backResearch', 'workspaceAction', 'coachGuide', 'clearAction', 'sendAction', 'stopAction', 'latestAction', 'greetingPrompt', 'phaseStart', 'phaseProbing', 'phaseFocused', 'phaseTitles', 'roundLabel', 'statusStart', 'statusProbing', 'statusFocused', 'statusTitles', 'statusSent', 'statusResponding', 'pendingCoach', 'selfLabel', 'continueAction', 'summarizeAction', 'titlesAction', 'retitleAction', 'reopenAction', 'saveChatAction', 'saveResultAction', 'copyResultAction', 'starterOne', 'starterTwo', 'starterThree', 'pdfAction', 'textAction', 'dropLabel', 'paperTextLabel', 'sourceTabLabel', 'repeatLabel', 'privacyNoteLabel', 'sourceNoteLabel', 'unsavedNoteLabel', 'introNoteLabel', 'previewAction', 'previewTitle', 'previewCopy', 'closeAction', 'responseLabel', 'readingProgress', 'rawOutputLabel', 'readingEditHint', 'saveCardAction', 'markdownAction', 'tsvAction', 'retryAction', 'newCardAction', 'copyRawAction', 'myQuestion', 'sourceLabel', 'editCitation', 'citationAuthors', 'citationYear', 'citationTitle', 'citationJournal', 'citationCore', 'relationBorrow', 'relationChallenge', 'relationGap', 'saveHeading', 'saveTitleLabel', 'saveAction', 'cancelAction', 'savedCardHeading', 'cardCitation', 'helpCitation', 'cardQuestion', 'helpQuestion', 'cardSample', 'helpSample', 'cardMethod', 'helpMethod', 'cardViewpoints', 'helpViewpoints', 'cardFindings', 'helpFindings', 'cardReferences', 'helpReferences', 'cardLimitations', 'helpLimitations', 'cardRelevance', 'helpRelevance', 'cardVerdict', 'helpVerdict', 'loginHint', 'coachLengthError', 'incompleteHint', 'readingRequiredError', 'readingFormatError', 'missingFieldsHint', 'copySuccess', 'copyFailure', 'clearConfirm', 'leaveConfirm', 'saveLengthError', 'saveFailure', 'cardSavedHint', 'coachSavedHint', 'pdfExtracting', 'pdfProgress', 'pdfExtracted', 'pdfScannedError', 'truncatedHint', 'textTruncatedHint', 'countTemplate', 'titleFormatHint', 'designEyebrow', 'designRole', 'designIntro', 'designAction', 'instrumentEyebrow', 'instrumentRole', 'instrumentIntro', 'instrumentAction', 'designGuide', 'designPrivacy', 'designImportLabel', 'designImportPrompt', 'designImportEmpty', 'designQuestionLabel', 'designQuestionPlaceholder', 'designTitleLabel', 'designTitlePlaceholder', 'designTitlePick', 'designConditionsLegend', 'designConditionsHint', 'stageLabel', 'designClassesLabel', 'designParallelLabel', 'designPeriodLabel', 'designDataLabel', 'designAbilityLabel', 'designSupportLabel', 'designPurposeLabel', 'designPreferenceLabel', 'designNotesLabel', 'designNotesPlaceholder', 'designGenerateAction', 'designProgress', 'designEmpty', 'designRequiredError', 'designFormatError', 'designResponseLabel', 'designAnalysisHeading', 'designScopeHeading', 'designTitleHeading', 'designRecommendedHeading', 'designMinimalLabel', 'designExcludedHeading', 'designPlanHeading', 'designToolsHeading', 'designEthicsHeading', 'designPendingHeading', 'designExistingMaterial', 'designToCoachAction', 'designToWorkshopAction', 'designTsvAction', 'designSaveAction', 'designSavedHint', 'designNewAction', 'designReadOnlyHint', 'coachHandoffAction', 'coachHandoffMissing', 'coachBusyHint', 'handoffConfirm', 'instrumentGuide', 'instrumentPrivacy', 'modeTabLabel', 'modeQuestionnaire', 'modeInterview', 'modeObservation', 'instrumentSourceLabel', 'sourc