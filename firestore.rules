rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function signedIn() {
      return authenticated()
        && (isAdmin() || (request.auth.token.email_verified == true
        && request.auth.token.email is string
        && !request.auth.token.email.lower().matches('.*@xylaoshi[.]tel')));
    }

    function isAdmin() {
      return authenticated()
        && request.auth.uid == 'MCUSTieySYczODKB9hkERtyvtZG2';
    }

    function isSelf(uid) {
      return authenticated() && request.auth.uid == uid;
    }

    function validUserProfile(uid) {
      return isSelf(uid)
        && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'school', 'isAdmin', 'joinedAt'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'school', 'isAdmin', 'joinedAt', 'privacy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && request.resource.data.school is string
        && request.resource.data.school.size() <= 120
        && request.resource.data.isAdmin is bool
        && request.resource.data.joinedAt is string;
    }

    function validPrivacyChange() {
      let p = request.resource.data.get('privacy', null);
      let old = resource.data.get('privacy', null);
      return p == old || validPrivacy(p, old);
    }
    function validPrivacy(p, old) {
      return p is map
        && p.keys().hasAll(['version','acceptedAt','research','researchVersion','researchUpdatedAt'])
        && p.keys().hasOnly(['version','acceptedAt','research','researchVersion','researchUpdatedAt'])
        && p.research == false && p.researchVersion == '2026-09-30.1'
        && p.researchUpdatedAt == request.time
        && ((p.version == '2026-09-30.1' && p.acceptedAt == request.time)
          || (old != null && p.version == old.version && p.acceptedAt == old.acceptedAt)
          || (old == null && p.version == '' && p.acceptedAt == null && p.research == false))
        && (!p.research || (p.version == '2026-09-30.1' && p.acceptedAt is timestamp));
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if validUserProfile(uid)
        && validPrivacy(request.resource.data.get('privacy', null), null)
        && request.resource.data.privacy.version == '2026-09-30.1'
        && request.resource.data.isAdmin == isAdmin();
      allow update: if isAdmin() || (
        validUserProfile(uid)
        && validPrivacyChange()
        && request.resource.data.isAdmin == resource.data.isAdmin
        && (request.resource.data.email == resource.data.email || (
          signedIn() && request.resource.data.email == request.auth.token.email
        ))
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.joinedAt == resource.data.joinedAt
      );
      allow delete: if isAdmin();
    }

    match /tools/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prompts/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /paths/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{docId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /resource_categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /page_copy/{pageId} {
      function validText(value, maxSize) {
        return value is string && value.size() > 0 && value.size() <= maxSize;
      }

      function validHomeCopy() {
        return request.resource.data.fields.keys().hasAll([
            'heroEyebrow', 'heroTitle', 'heroAccent', 'heroIntro', 'primaryAction',
            'workbookActionGuest', 'workbookActionMember', 'taskHeading',
            'checklistHeading', 'checklistAction', 'resourcesHeading'
          ])
          && request.resource.data.fields.keys().hasOnly([
            'heroEyebrow', 'heroTitle', 'heroAccent', 'heroIntro', 'primaryAction',
            'workbookActionGuest', 'workbookActionMember', 'taskHeading',
            'checklistHeading', 'checklistAction', 'resourcesHeading'
          ])
          && validText(request.resource.data.fields.heroEyebrow, 40)
          && validText(request.resource.data.fields.heroTitle, 50)
          && validText(request.resource.data.fields.heroAccent, 12)
          && validText(request.resource.data.fields.heroIntro, 140)
          && validText(request.resource.data.fields.primaryAction, 24)
          && validText(request.resource.data.fields.workbookActionGuest, 24)
          && validText(request.resource.data.fields.workbookActionMember, 24)
          && validText(request.resource.data.fields.taskHeading, 40)
          && validText(request.resource.data.fields.checklistHeading, 30)
          && validText(request.resource.data.fields.checklistAction, 20)
          && validText(request.resource.data.fields.resourcesHeading, 40);
      }

      function validMultimodalCopy() {
        return request.resource.data.fields.keys().hasAll([
            'heroKicker', 'heroTitle', 'heroAccent', 'heroIntro', 'heroNote',
            'primaryAction', 'secondaryAction', 'featureKicker', 'featureTitle', 'featureAction'
          ])
          && request.resource.data.fields.keys().hasOnly([
            'heroKicker', 'heroTitle', 'heroAccent', 'heroIntro', 'heroNote',
            'primaryAction', 'secondaryAction', 'featureKicker', 'featureTitle', 'featureAction'
          ])
          && validText(request.resource.data.fields.heroKicker, 40)
          && validText(request.resource.data.fields.heroTitle, 50)
          && validText(request.resource.data.fields.heroAccent, 12)
          && validText(request.resource.data.fields.heroIntro, 120)
          && validText(request.resource.data.fields.heroNote, 80)
          && validText(request.resource.data.fields.primaryAction, 24)
          && validText(request.resource.data.fields.secondaryAction, 24)
          && validText(request.resource.data.fields.featureKicker, 40)
          && validText(request.resource.data.fields.featureTitle, 50)
          && validText(request.resource.data.fields.featureAction, 40);
      }

      function validResearchCopy() {
        return request.resource.data.fields.keys().hasAll(['heroKicker', 'heroTitle', 'heroIntro', 'literatureTitle', 'literatureIntro', 'judgmentTitle', 'judgmentIntro', 'privacyTitle', 'privacyIntro', 'funnelEyebrow', 'funnelRole', 'funnelIntro', 'funnelAction', 'funnelGreeting', 'readingEyebrow', 'readingRole', 'readingIntro', 'readingAction', 'libraryGuest', 'libraryMember', 'libraryIntro', 'moreTools', 'funnelPrivacy', 'funnelUnsaved', 'composeLabel', 'composePlaceholder', 'sourceHint', 'questionLabel', 'questionPlaceholder', 'metaLabel', 'metaPlaceholder', 'repeatHint', 'readingPrivacy', 'readingEmpty', 'libraryTitle', 'libraryExportHint', 'libraryEmpty', 'generateAction', 'noteLabel', 'backResearch', 'workspaceAction', 'coachGuide', 'clearAction', 'sendAction', 'stopAction', 'latestAction', 'greetingPrompt', 'phaseStart', 'phaseProbing', 'phaseFocused', 'phaseTitles', 'roundLabel', 'statusStart', 'statusProbing', 'statusFocused', 'statusTitles', 'statusSent', 'statusResponding', 'pendingCoach', 'selfLabel', 'continueAction', 'summarizeAction', 'titlesAction', 'retitleAction', 'reopenAction', 'saveChatAction', 'saveResultAction', 'copyResultAction', 'starterOne', 'starterTwo', 'starterThree', 'pdfAction', 'textAction', 'dropLabel', 'paperTextLabel', 'sourceTabLabel', 'repeatLabel', 'privacyNoteLabel', 'sourceNoteLabel', 'unsavedNoteLabel', 'introNoteLabel', 'previewAction', 'previewTitle', 'previewCopy', 'closeAction', 'responseLabel', 'readingProgress', 'rawOutputLabel', 'readingEditHint', 'saveCardAction', 'markdownAction', 'tsvAction', 'retryAction', 'newCardAction', 'copyRawAction', 'myQuestion', 'sourceLabel', 'editCitation', 'citationAuthors', 'citationYear', 'citationTitle', 'citationJournal', 'citationCore', 'relationBorrow', 'relationChallenge', 'relationGap', 'saveHeading', 'saveTitleLabel', 'saveAction', 'cancelAction', 'savedCardHeading', 'cardCitation', 'helpCitation', 'cardQuestion', 'helpQuestion', 'cardSample', 'helpSample', 'cardMethod', 'helpMethod', 'cardViewpoints', 'helpViewpoints', 'cardFindings', 'helpFindings', 'cardReferences', 'helpReferences', 'cardLimitations', 'helpLimitations', 'cardRelevance', 'helpRelevance', 'cardVerdict', 'helpVerdict', 'loginHint', 'coachLengthError', 'incompleteHint', 'readingRequiredError', 'readingFormatError', 'missingFieldsHint', 'copySuccess', 'copyFailure', 'clearConfirm', 'leaveConfirm', 'saveLengthError', 'saveFailure', 'cardSavedHint', 'coachSavedHint', 'pdfExtracting', 'pdfProgress', 'pdfExtracted', 'pdfScannedError', 'truncatedHint', 'textTruncatedHint', 'countTemplate', 'titleFormatHint'])
          && request.resource.data.fields.keys().hasOnly(['heroKicker', 'heroTitle', 'heroIntro', 'literatureTitle', 'literatureIntro', 'judgmentTitle', 'judgmentIntro', 'privacyTitle', 'privacyIntro', 'funnelEyebrow', 'funnelRole', 'funnelIntro', 'funnelAction', 'funnelGreeting', 'readingEyebrow', 'readingRole', 'readingIntro', 'readingAction', 'libraryGuest', 'libraryMember', 'libraryIntro', 'moreTools', 'funnelPrivacy', 'funnelUnsaved', 'composeLabel', 'composePlaceholder', 'sourceHint', 'questionLabel', 'questionPlaceholder', 'metaLabel', 'metaPlaceholder', 'repeatHint', 'readingPrivacy', 'readingEmpty', 'libraryTitle', 'libraryExportHint', 'libraryEmpty', 'generateAction', 'noteLabel', 'backResearch', 'workspaceAction', 'coachGuide', 'clearAction', 'sendAction', 'stopAction', 'latestAction', 'greetingPrompt', 'phaseStart', 'phaseProbing', 'phaseFocused', 'phaseTitles', 'roundLabel', 'statusStart', 'statusProbing', 'statusFocused', 'statusTitles', 'statusSent', 'statusResponding', 'pendingCoach', 'selfLabel', 'continueAction', 'summarizeAction', 'titlesAction', 'retitleAction', 'reopenAction', 'saveChatAction', 'saveResultAction', 'copyResultAction', 'starterOne', 'starterTwo', 'starterThree', 'pdfAction', 'textAction', 'dropLabel', 'paperTextLabel', 'sourceTabLabel', 'repeatLabel', 'privacyNoteLabel', 'sourceNoteLabel', 'unsavedNoteLabel', 'introNoteLabel', 'previewAction', 'previewTitle', 'previewCopy', 'closeAction', 'responseLabel', 'readingProgress', 'rawOutputLabel', 'readingEditHint', 'saveCardAction', 'markdownAction', 'tsvAction', 'retryAction', 'newCardAction', 'copyRawAction', 'myQuestion', 'sourceLabel', 'editCitation', 'citationAuthors', 'citationYear', 'citationTitle', 'citationJournal', 'citationCore', 'relationBorrow', 'relationChallenge', 'relationGap', 'saveHeading', 'saveTitleLabel', 'saveAction', 'cancelAction', 'savedCardHeading', 'cardCitation', 'helpCitation', 'cardQuestion', 'helpQuestion', 'cardSample', 'helpSample', 'cardMethod', 'helpMethod', 'cardViewpoints', 'helpViewpoints', 'cardFindings', 'helpFindings', 'cardReferences', 'helpReferences', 'cardLimitations', 'helpLimitations', 'cardRelevance', 'helpRelevance', 'cardVerdict', 'helpVerdict', 'loginHint', 'coachLengthError', 'incompleteHint', 'readingRequiredError', 'readingFormatError', 'missingFieldsHint', 'copySuccess', 'copyFailure', 'clearConfirm', 'leaveConfirm', 'saveLengthError', 'saveFailure', 'cardSavedHint', 'coachSavedHint', 'pdfExtracting', 'pdfProgress', 'pdfExtracted', 'pdfScannedError', 'truncatedHint', 'textTruncatedHint', 'countTemplate', 'titleFormatHint'])
          && validText(request.resource.data.fields.heroKicker, 40)
          && validText(request.resource.data.fields.heroTitle, 50)
          && validText(request.resource.data.fields.heroIntro, 180)
          && validText(request.resource.data.fields.literatureTitle, 30)
          && validText(request.resource.data.fields.literatureIntro, 180)
          && validText(request.resource.data.fields.judgmentTitle, 30)
          && validText(request.resource.data.fields.judgmentIntro, 180)
          && validText(request.resource.data.fields.privacyTitle, 30)
          && validText(request.resource.data.fields.privacyIntro, 180)
          && validText(request.resource.data.fields.funnelEyebrow, 40)
          && validText(request.resource.data.fields.funnelRole, 20)
          && validText(request.resource.data.fields.funnelIntro, 180)
          && validText(request.resource.data.fields.funnelAction, 50)
          && validText(request.resource.data.fields.funnelGreeting, 600)
          && validText(request.resource.data.fields.readingEyebrow, 40)
          && validText(request.resource.data.fields.readingRole, 20)
          && validText(request.resource.data.fields.readingIntro, 180)
          && validText(request.resource.data.fields.readingAction, 50)
          && validText(request.resource.data.fields.libraryGuest, 80)
          && validText(request.resource.data.fields.libraryMember, 30)
          && validText(request.resource.data.fields.libraryIntro, 100)
          && validText(request.resource.data.fields.moreTools, 140)
          && validText(request.resource.data.fields.funnelPrivacy, 180)
          && validText(request.resource.data.fields.funnelUnsaved, 100)
          && validText(request.resource.data.fields.composeLabel, 60)
          && validText(request.resource.data.fields.composePlaceholder, 100)
          && validText(request.resource.data.fields.sourceHint, 300)
          && validText(request.resource.data.fields.questionLabel, 60)
          && validText(request.resource.data.fields.questionPlaceholder, 140)
          && validText(request.resource.data.fields.metaLabel, 60)
          && validText(request.resource.data.fields.metaPlaceholder, 140)
          && validText(request.resource.data.fields.repeatHint, 160)
          && validText(request.resource.data.fields.readingPrivacy, 500)
          && validText(request.resource.data.fields.readingEmpty, 140)
          && validText(request.resource.data.fields.libraryTitle, 40)
          && validText(request.resource.data.fields.libraryExportHint, 180)
          && validText(request.resource.data.fields.libraryEmpty, 140)
          && validText(request.resource.data.fields.generateAction, 30)
          && validText(request.resource.data.fields.noteLabel, 100)
          && validText(request.resource.data.fields.backResearch, 100)
          && validText(request.resource.data.fields.workspaceAction, 100)
          && validText(request.resource.data.fields.coachGuide, 100)
          && validText(request.resource.data.fields.clearAction, 100)
          && validText(request.resource.data.fields.sendAction, 100)
          && validText(request.resource.data.fields.stopAction, 100)
          && validText(request.resource.data.fields.latestAction, 100)
          && validText(request.resource.data.fields.greetingPrompt, 100)
          && validText(request.resource.data.fields.phaseStart, 100)
          && validText(request.resource.data.fields.phaseProbing, 100)
          && validText(request.resource.data.fields.phaseFocused, 100)
          && validText(request.resource.data.fields.phaseTitles, 100)
          && validText(request.resource.data.fields.roundLabel, 100)
          && validText(request.resource.data.fields.statusStart, 100)
          && validText(request.resource.data.fields.statusProbing, 100)
          && validText(request.resource.data.fields.statusFocused, 100)
          && validText(request.resource.data.fields.statusTitles, 100)
          && validText(request.resource.data.fields.statusSent, 100)
          && validText(request.resource.data.fields.statusResponding, 100)
          && validText(request.resource.data.fields.pendingCoach, 100)
          && validText(request.resource.data.fields.selfLabel, 100)
          && validText(request.resource.data.fields.continueAction, 100)
          && validText(request.resource.data.fields.summarizeAction, 100)
          && validText(request.resource.data.fields.titlesAction, 100)
          && validText(request.resource.data.fields.retitleAction, 100)
          && validText(request.resource.data.fields.reopenAction, 100)
          && validText(request.resource.data.fields.saveChatAction, 100)
          && validText(request.resource.data.fields.saveResultAction, 100)
          && validText(request.resource.data.fields.copyResultAction, 100)
          && validText(request.resource.data.fields.starterOne, 100)
          && validText(request.resource.data.fields.starterTwo, 100)
          && validText(request.resource.data.fields.starterThree, 100)
          && validText(request.resource.data.fields.pdfAction, 100)
          && validText(request.resource.data.fields.textAction, 100)
          && validText(request.resource.data.fields.dropLabel, 100)
          && validText(request.resource.data.fields.paperTextLabel, 100)
          && validText(request.resource.data.fields.sourceTabLabel, 100)
          && validText(request.resource.data.fields.repeatLabel, 100)
          && validText(request.resource.data.fields.privacyNoteLabel, 100)
          && validText(request.resource.data.fields.sourceNoteLabel, 100)
          && validText(request.resource.data.fields.unsavedNoteLabel, 100)
          && validText(request.resource.data.fields.introNoteLabel, 100)
          && validText(request.resource.data.fields.previewAction, 100)
          && validText(request.resource.data.fields.previewTitle, 100)
          && validText(request.resource.data.fields.previewCopy, 100)
          && validText(request.resource.data.fields.closeAction, 100)
          && validText(request.resource.data.fields.responseLabel, 100)
          && validText(request.resource.data.fields.readingProgress, 100)
          && validText(request.resource.data.fields.rawOutputLabel, 100)
          && validText(request.resource.data.fields.readingEditHint, 400)
          && validText(request.resource.data.fields.saveCardAction, 100)
          && validText(request.resource.data.fields.markdownAction, 100)
          && validText(request.resource.data.fields.tsvAction, 100)
          && validText(request.resource.data.fields.retryAction, 100)
          && validText(request.resource.data.fields.newCardAction, 100)
          && validText(request.resource.data.fields.copyRawAction, 100)
          && validText(request.resource.data.fields.myQuestion, 100)
          && validText(request.resource.data.fields.sourceLabel, 100)
          && validText(request.resource.data.fields.editCitation, 100)
          && validText(request.resource.data.fields.citationAuthors, 100)
          && validText(request.resource.data.fields.citationYear, 100)
          && validText(request.resource.data.fields.citationTitle, 100)
          && validText(request.resource.data.fields.citationJournal, 100)
          && validText(request.resource.data.fields.citationCore, 100)
          && validText(request.resource.data.fields.relationBorrow, 100)
          && validText(request.resource.data.fields.relationChallenge, 100)
          && validText(request.resource.data.fields.relationGap, 100)
          && validText(request.resource.data.fields.saveHeading, 100)
          && validText(request.resource.data.fields.saveTitleLabel, 100)
          && validText(request.resource.data.fields.saveAction, 100)
          && validText(request.resource.data.fields.cancelAction, 100)
          && validText(request.resource.data.fields.savedCardHeading, 100)
          && validText(request.resource.data.fields.cardCitation, 100)
          && validText(request.resource.data.fields.helpCitation, 400)
          && validText(request.resource.data.fields.cardQuestion, 100)
          && validText(request.resource.data.fields.helpQuestion, 400)
          && validText(request.resource.data.fields.cardSample, 100)
          && validText(request.resource.data.fields.helpSample, 400)
          && validText(request.resource.data.fields.cardMethod, 100)
          && validText(request.resource.data.fields.helpMethod, 400)
          && validText(request.resource.data.fields.cardViewpoints, 100)
          && validText(request.resource.data.fields.helpViewpoints, 400)
          && validText(request.resource.data.fields.cardFindings, 100)
          && validText(request.resource.data.fields.helpFindings, 400)
          && validText(request.resource.data.fields.cardReferences, 100)
          && validText(request.resource.data.fields.helpReferences, 400)
          && validText(request.resource.data.fields.cardLimitations, 100)
          && validText(request.resource.data.fields.helpLimitations, 400)
          && validText(request.resource.data.fields.cardRelevance, 100)
          && validText(request.resource.data.fields.helpRelevance, 400)
          && validText(request.resource.data.fields.cardVerdict, 100)
          && validText(request.resource.data.fields.helpVerdict, 400)
          && validText(request.resource.data.fields.loginHint, 300)
          && validText(request.resource.data.fields.coachLengthError, 300)
          && validText(request.resource.data.fields.incompleteHint, 300)
          && validText(request.resource.data.fields.readingRequiredError, 300)
          && validText(request.resource.data.fields.readingFormatError, 300)
          && validText(request.resource.data.fields.missingFieldsHint, 300)
          && validText(request.resource.data.fields.copySuccess, 300)
          && validText(request.resource.data.fields.copyFailure, 300)
          && validText(request.resource.data.fields.clearConfirm, 300)
          && validText(request.resource.data.fields.leaveConfirm, 300)
          && validText(request.resource.data.fields.saveLengthError, 300)
          && validText(request.resource.data.fields.saveFailure, 300)
          && validText(request.resource.data.fields.cardSavedHint, 300)
          && validText(request.resource.data.fields.coachSavedHint, 300)
          && validText(request.resource.data.fields.pdfExtracting, 300)
          && validText(request.resource.data.fields.pdfProgress, 300)
          && validText(request.resource.data.fields.pdfExtracted, 300)
          && validText(request.resource.data.fields.pdfScannedError, 300)
          && validText(request.resource.data.fields.truncatedHint, 300)
          && validText(request.resource.data.fields.textTruncatedHint, 300)
          && validText(request.resource.data.fields.countTemplate, 300)
          && validText(request.resource.data.fields.titleFormatHint, 300)
          ;
      }

      function validExtendedPageCopy() {
        return pageId in [
            'agents', 'classroom', 'tools', 'resources', 'news', 'paths',
            'articles', 'article', 'prompts', 'workspace'
          ]
          && request.resource.data.fields.keys().size() > 0
          && request.resource.data.fields.keys().size() <= 40;
      }

      allow read: if pageId in [
          'home', 'multimodal', 'agents', 'classroom', 'tools', 'resources',
          'news', 'paths', 'articles', 'article', 'prompts', 'workspace', 'research'
        ];
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['fields', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['fields', 'updatedAt'])
        && request.resource.data.fields is map
        && request.resource.data.updatedAt is string
        && (
          (pageId == 'home' && validHomeCopy())
          || (pageId == 'multimodal' && validMultimodalCopy())
          || (pageId == 'research' && validResearchCopy())
          || validExtendedPageCopy()
        );
      allow delete: if isAdmin();
    }

    match /community_prompts/{promptId} {
      function isAuthor() {
        return signedIn() && resource.data.authorId == request.auth.uid;
      }

      function validCreate() {
        return signedIn()
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'category', 'createdAt', 'label', 'likedBy', 'likes', 'note', 'status', 'text'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'category', 'createdAt', 'label', 'likedBy', 'likes', 'note', 'status', 'text'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string
          && request.resource.data.authorName.size() <= 80
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 8000
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 500
          && request.resource.data.category in ['teaching', 'advanced', 'communication', 'other']
          && request.resource.data.status == 'pending'
          && request.resource.data.likes == 0
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size() == 0
          && request.resource.data.createdAt is string;
      }

      function validLikeToggle() {
        return signedIn()
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'likes'])
          && request.resource.data.likedBy is list
          && request.resource.data.likes is int
          && request.resource.data.likes >= 0
          && request.resource.data.likes == request.resource.data.likedBy.size()
          && request.resource.data.likedBy.toSet().size() == request.resource.data.likedBy.size()
          && (
            (!(request.auth.uid in resource.data.likedBy)
              && request.auth.uid in request.resource.data.likedBy
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1)
              && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
              && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).size() == 0
            ||
            (request.auth.uid in resource.data.likedBy
              && !(request.auth.uid in request.resource.data.likedBy)
              && request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1)
              && resource.data.likedBy.toSet().difference(request.resource.data.likedBy.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.likedBy.toSet().difference(resource.data.likedBy.toSet()).size() == 0
          );
      }

      allow read: if resource.data.status == 'approved' || isAuthor() || isAdmin();
      allow create: if validCreate();
      allow update: if isAdmin() || validLikeToggle();
      allow delete: if isAdmin() || isAuthor();
    }

    match /subscribers/{subscriberId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['email', 'subscribedAt'])
        && request.resource.data.keys().hasOnly(['email', 'subscribedAt'])
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 254
        && request.resource.data.subscribedAt is string;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /contact_messages/{messageId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['contact', 'createdAt', 'handled', 'message', 'name', 'page', 'userEmail', 'userId', 'userPhone'])
        && request.resource.data.keys().hasOnly(['contact', 'createdAt', 'handled', 'message', 'name', 'page', 'userEmail', 'userId', 'userPhone'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 500
        && request.resource.data.handled == false
        && request.resource.data.createdAt is timestamp;
      allow read, update, delete: if isAdmin();
    }

    match /works/{workId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 200000;
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 200000;
    }

    match /agent_usage/{agentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasAll(['count', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == 1;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isAdmin();
    }

    match /tool_ratings/{docId} {
      allow read, write: if false;
    }

    match /analytics_events/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
