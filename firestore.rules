          && request.resource.data.fields.keys().hasOnly(['heroKicker', 'heroTitle', 'heroIntro', 'literatureTitle', 'literatureIntro', 'judgmentTitle', 'judgmentIntro', 'privacyTitle', 'privacyIntro', 'funnelEyebrow', 'funnelRole', 'funnelIntro', 'funnelAction', 'funnelGreeting', 'readingEyebrow', 'readingRole', 'readingIntro', 'readingAction', 'libraryGuest', 'libraryMember', 'libraryIntro', 'moreTools', 'funnelPrivacy', 'funnelUnsaved', 'composeLabel', 'composePlaceholder', 'sourceHint', 'questionLabel', 'questionPlaceholder', 'metaLabel', 'metaPlaceholder', 'repeatHint', 'readingPrivacy', 'readingEmpty', 'libraryTitle', 'libraryExportHint', 'libraryEmpty', 'generateAction', 'noteLabel', 'backResearch', 'workspaceAction', 'coachGuide', 'clearAction', 'sendAction', 'stopAction', 'latestAction', 'greetingPrompt', 'phaseStart', 'phaseProbing', 'phaseFocused', 'phaseTitles', 'roundLabel', 'statusStart', 'statusProbing', 'statusFocused', 'statusTitles', 'statusSent', 'statusResponding', 'pendingCoach', 'selfLabel', 'continueAction', 'summarizeAction', 'titlesAction', 'retitleAction', 'reopenAction', 'saveChatAction', 'saveResultAction', 'copyResultAction', 'starterOne', 'starterTwo', 'starterThree', 'pdfAction', 'textAction', 'dropLabel', 'paperTextLabel', 'sourceTabLabel', 'repeatLabel', 'privacyNoteLabel', 'sourceNoteLabel', 'unsavedNoteLabel', 'introNoteLabel', 'previewAction', 'previewTitle', 'previewCopy', 'closeAction', 'responseLabel', 'readingProgress', 'rawOutputLabel', 'readingEditHint', 'saveCardAction', 'markdownAction', 'tsvAction', 'retryAction', 'newCardAction', 'copyRawAction', 'myQuestion', 'sourceLabel', 'editCitation', 'citationAuthors', 'citationYear', 'citationTitle', 'citationJournal', 'citationCore', 'relationBorrow', 'relationChallenge', 'relationGap', 'saveHeading', 'saveTitleLabel', 'saveAction', 'cancelAction', 'savedCardHeading', 'cardCitation', 'helpCitation', 'cardQuestion', 'helpQuestion', 'cardSample', 'helpSample', 'cardMethod', 'helpM